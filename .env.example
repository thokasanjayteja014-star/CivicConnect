# Root .env for docker compose. Names only — fill in your own values, never commit them.
AUTH_SECRET=
POSTGRES_PASSWORD=

# AI (xai = Grok, groq, openai)
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=
# Optional: speech-to-text for voice notes (Grok has none; Groq's whisper is free)
SPEECH_PROVIDER=
SPEECH_API_KEY=
SPEECH_MODEL_NAME=

# Email notifications: EMAIL_PROVIDER=smtp (e.g. Gmail app password) or brevo
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
BREVO_API_KEY=

# SMS notifications: SMS_PROVIDER=twilio
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Browser push: generate with  docker compose exec backend python -m app.cli generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Address search (OpenStreetMap Nominatim): your email, as their usage policy asks
GEOCODER_CONTACT_EMAIL=
